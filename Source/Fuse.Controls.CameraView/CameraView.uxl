<extensions backend="cplusplus" condition="ANDROID">
	<require androidManifest.permission="android.permission.CAMERA" />
	<require androidManifest.permission="android.permission.RECORD_AUDIO" />
	<require androidManifest.permission="android.permission.WRITE_EXTERNAL_STORAGE" />

	<require gradle.dependency.implementation="androidx.camera:camera-core:1.4.2" />
	<require gradle.dependency.implementation="androidx.camera:camera-camera2:1.4.2" />
	<require gradle.dependency.implementation="androidx.camera:camera-lifecycle:1.4.2" />
	<require gradle.dependency.implementation="androidx.camera:camera-view:1.4.2" />
	<require gradle.dependency.implementation="androidx.camera:camera-video:1.4.2" />
	<require gradle.dependency.implementation="com.google.mlkit:barcode-scanning:17.2.0" />
	<require gradle.dependency.implementation="com.google.mlkit:face-detection:16.1.6" />
	<require gradle.dependency.implementation="com.drewnoakes:metadata-extractor:2.10.1" />
</extensions>
