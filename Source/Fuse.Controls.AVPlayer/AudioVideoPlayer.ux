<Fuse.Controls.AVPlayerBase ux:Class="Fuse.Controls.MediaPlayer" ux:Name="self">
	<Panel
		ux:Template="GraphicsAppearance"
		Margin="4"
		Background="#eee"
		Padding="30"
	>
		<Text
			Value="GraphicsAppearance for MediaPlayer not implemented!"
			Alignment="Center"
			TextWrapping="Wrap"
		/>
		<Rectangle Layer="Background">
			<Stroke Color="#000" />
		</Rectangle>
	</Panel>
	<Fuse.Controls.Native.iOS.AVPlayerView
		ux:Condition="iOS"
		ux:Template="iOSAppearance"
		Host="self"
	/>
	<Fuse.Controls.Native.Android.AVPlayerView
		ux:Condition="Android"
		ux:Template="AndroidAppearance"
		Host="self"
	/>
</Fuse.Controls.AVPlayerBase>
