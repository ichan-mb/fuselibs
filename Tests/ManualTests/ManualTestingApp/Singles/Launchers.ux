<Page Title="Launchers" ux:Class="Launchers">
	<InfoStack ux:Key="Info">
		<p>This part tests various launchers</p>
		<ul>
		<li>The "send email"-button should try to send an e-mail to email@example.com, with the subject "test", and message "Hello to email@example.com"</li>
		<li>The "fusetools.com"-button should open fusetools.com in a browser</li>
		<li>The "Show fusetools on map" and "Show fusetools on map (JS)"-buttons should open a map-view around the fusetools offices in Oslo/Norway</li>
		<li>The "Show Fuse with label (JS)"-button should open the map centered on Fusetools with a "Fuse" label and zoom level 16</li>
		<li>The "Show Fuse with label (UX)"-button should open the map with a satellite base map, a "Fuse" label and zoom level 16</li>
		<li>The "Directions to Fuse (JS)" and "Directions to Fuse (UX)"-buttons should open walking directions to the Fusetools offices</li>
		<li>The "Directions by address (JS)"-button should open transit directions to the given address</li>
		<li>The "Maps available? (JS)"-button should log whether a native map app is available</li>
		<li>The "Find pizza"-button should search for pizza resturants on the map near the users current position</li>
		<li>The "Find pizza near Fusetools"-button should search for pizza resturants on the map near the Fusetools offices in Oslo/Norway</li>
		<li>The "Who you gonna call?"-button should try to call the Ghostbusters (1-800-555-2368)</li>
		<li>The "Send SMS (JS)"-button should open the messaging app with a body for the Ghostbusters</li>
		<li>The "FaceTime (JS)"-button should open FaceTime on iOS and log an error on other platforms</li>
		</ul>
	</InfoStack>
	<StackPanel Margin="20">
		<JavaScript>
			var Maps = require("FuseJS/Maps");
			var Email = require("FuseJS/Email");
			var Phone = require("FuseJS/Phone");

			function showFusetools() {
				Maps.openAt(59.9117715, 10.7400957);
			}

			function findPizza() {
				Maps.searchNearby("pizza resturant");
			}

			function findPizzaNearFusetools() {
				Maps.searchNear(59.9117715, 10.7400957, "pizza resturant");
			}

			function showFusetoolsLabeled() {
				Maps.open({
					latitude: 59.9117715,
					longitude: 10.7400957,
					label: "Fuse",
					zoom: 16
				}).then(function(result) {
					console.log("Maps: " + result.status);
				}).catch(function(error) {
					console.log("Maps failed: " + error);
				});
			}

			function directionsToFusetools() {
				Maps.directions({
					to: { latitude: 59.9117715, longitude: 10.7400957, label: "Fuse" },
					mode: "walking"
				}).then(function(result) {
					console.log("Directions: " + result.status);
				}).catch(function(error) {
					console.log("Directions failed: " + error);
				});
			}

			function directionsByAddress() {
				Maps.directions({
					to: "Some Street 1, Oslo",
					mode: "transit"
				}).then(function(result) {
					console.log("Directions: " + result.status);
				}).catch(function(error) {
					console.log("Directions failed: " + error);
				});
			}

			function checkMapsAvailable() {
				console.log("Maps available: " + Maps.isAvailable());
			}

			function sendRichEmail() {
				Email.compose({
					to: ["email@example.com"],
					subject: "Test",
					body: "Hello to email@example.com",
					htmlBody: "<b>Hello</b> to email@example.com"
				}).then(function(result) {
					console.log("Email: " + result.status);
				}).catch(function(error) {
					console.log("Email failed: " + error);
				});
			}

			function sendSms() {
				Phone.sms({
					to: ["1-800-555-2368"],
					body: "Hello from Fuse"
				}).then(function(result) {
					console.log("SMS: " + result.status);
				}).catch(function(error) {
					console.log("SMS failed: " + error);
				});
			}

			function sendFaceTime() {
				Phone.call("1-800-555-2368", { faceTime: true }).then(function(result) {
					console.log("FaceTime: " + result.status);
				}).catch(function(error) {
					console.log("FaceTime failed: " + error);
				});
			}

			module.exports = {
				showFusetools: showFusetools,
				findPizza: findPizza,
				findPizzaNearFusetools: findPizzaNearFusetools,
				showFusetoolsLabeled: showFusetoolsLabeled,
				directionsToFusetools: directionsToFusetools,
				directionsByAddress: directionsByAddress,
				checkMapsAvailable: checkMapsAvailable,
				sendRichEmail: sendRichEmail,
				sendSms: sendSms,
				sendFaceTime: sendFaceTime
			};
		</JavaScript>

		<StdButton Text="Send email">
			<Clicked>
				<LaunchEmail To="email@example.com" Subject="Test" CarbonCopy="" BlindCarbonCopy="" Message="Hello to email@example.com" />
			</Clicked>
		</StdButton>

		<StdButton Text="Send HTML email (JS)">
			<Clicked>
				<Callback Handler="{sendRichEmail}" />
			</Clicked>
		</StdButton>

		<StdButton Text="fusetools.com">
			<Clicked>
				<LaunchUri Uri="https://www.fusetools.com/" />
			</Clicked>
		</StdButton>

		<StdButton Text="Show fusetools on map">
			<Clicked>
				<LaunchMaps Latitude="59.9117715" Longitude="10.7400957"  />
			</Clicked>
		</StdButton>

		<StdButton Text="Show fusetools on map (JS)">
			<Clicked>
				<Callback Handler="{showFusetools}" />
			</Clicked>
		</StdButton>

		<StdButton Text="Find pizza">
			<Clicked>
				<Callback Handler="{findPizza}" />
			</Clicked>
		</StdButton>

		<StdButton Text="Find pizza near Fusetools">
			<Clicked>
				<Callback Handler="{findPizzaNearFusetools}" />
			</Clicked>
		</StdButton>

		<StdButton Text="Show Fuse with label (JS)">
			<Clicked>
				<Callback Handler="{showFusetoolsLabeled}" />
			</Clicked>
		</StdButton>

		<StdButton Text="Show Fuse with label (UX)">
			<Clicked>
				<LaunchMaps Latitude="59.9117715" Longitude="10.7400957"
					Label="Fuse" Zoom="16" MapType="Satellite" />
			</Clicked>
		</StdButton>

		<StdButton Text="Directions to Fuse (JS)">
			<Clicked>
				<Callback Handler="{directionsToFusetools}" />
			</Clicked>
		</StdButton>

		<StdButton Text="Directions by address (JS)">
			<Clicked>
				<Callback Handler="{directionsByAddress}" />
			</Clicked>
		</StdButton>

		<StdButton Text="Directions to Fuse (UX)">
			<Clicked>
				<LaunchDirections Latitude="59.9139" Longitude="10.7522"
					DestinationLatitude="59.9117715" DestinationLongitude="10.7400957"
					DestinationLabel="Fuse" TravelMode="Walking" />
			</Clicked>
		</StdButton>

		<StdButton Text="Maps available? (JS)">
			<Clicked>
				<Callback Handler="{checkMapsAvailable}" />
			</Clicked>
		</StdButton>

		<StdButton Text="Who you gonna call?">
			<Clicked>
				<Call Number="1-800-555-2368" />
			</Clicked>
		</StdButton>

		<StdButton Text="Send SMS (JS)">
			<Clicked>
				<Callback Handler="{sendSms}" />
			</Clicked>
		</StdButton>

		<StdButton Text="FaceTime (JS)">
			<Clicked>
				<Callback Handler="{sendFaceTime}" />
			</Clicked>
		</StdButton>
	</StackPanel>
</Page>
