<Page Title="Sharing" ux:Class="SharingPage">
	<!-- The info will be hidden by the web view -->
	<InfoStack ux:Key="Info">
		<p>This page has buttons for testing sharing of content: text, a captured photo, and the options-based API.</p>
	</InfoStack>
	<JavaScript>
		var share = require("FuseJS/Share")
		var camera = require("FuseJS/Camera")
		var imageTools = require("FuseJS/ImageTools")
		module.exports = {
			textShareTest : function()
			{
				share.shareText("Hello World", "Text from Fuse");
			},
			optionsShareTest : function()
			{
				share.share({
					text: "The link to Fuse Open website",
					url: "https://fuseopen.com/",
					subject: "Fuse Open",
					chooserTitle: "Share via"
				}).then(function(result) {
					console.log("Share completed: " + result.completed + " via " + result.activityType);
				}).catch(function(error) {
					console.log("Share failed: " + error);
				});
			},
			photoShareTest : function()
			{
				camera.takePicture(320,240) .then(function(image) {
					var path = image.path;
					console.log("Got image, sharing time! " + path);
					share.shareFile(path, "image/*", "Photo from Fuse");
				});
			}
		}
	</JavaScript>
	<NativeViewHost>
		<DockPanel>
			<WhileVisible>
				<StackPanel Dock="Bottom">
					<Button Text="Capture and share photo" Clicked="{photoShareTest}"/>
					<Button Text="Share text 'Hello world'" Clicked="{textShareTest}"/>
					<Button Text="Share text and URL" Clicked="{optionsShareTest}"/>
				</StackPanel>
			</WhileVisible>
		</DockPanel>
	</NativeViewHost>
</Page>
